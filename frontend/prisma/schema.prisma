generator client {
  provider = "prisma-client-js"
}

// Supabase Postgres:
// DATABASE_URL  = transaction pooler (port 6543, ?pgbouncer=true)
// DIRECT_URL    = session pooler or direct (port 5432, migrate / db push)
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Editorial news for the Home "In the news" cards. `link` is the story URL and
// `image` its image URL (the names the UI already reads). Dynamic CITY / SPORTS
// rows are written by lib/news/ingest.ts; see docs/news.md.
model News {
  id             String    @id @default(cuid())
  title          String
  description    String?
  image          String?
  imageSource    String?
  imageSourceUrl String?
  link           String?
  canonicalUrl   String?   @unique
  titleKey       String?   @unique
  contentHash    String?   @unique
  sourceName     String?
  sourceDomain   String?
  publishedAt    DateTime?
  discoveredAt   DateTime  @default(now())
  lastSeenAt     DateTime?
  type           String    @default("CITY") // NEWSPAPER | CITY | SPORTS
  category       String?
  eventSlug      String?
  eventPhase     String?
  score          Float     @default(0)
  isActive       Boolean   @default(true)
  featuredAt     DateTime?
  cooldownUntil  DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([type, isActive, publishedAt(sort: Desc)])
  @@index([type, featuredAt(sort: Desc)])
  @@index([eventSlug])
  @@map("news")
}

model MarketplaceItem {
  id        String   @id @default(cuid())
  title     String
  location  String?
  price     String?
  image     String?
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@map("marketplace_items")
}

model Place {
  id               String                                 @id @default(cuid())
  slug             String?                                @unique
  name             String
  description      String?
  image            String?
  location         String?
  address          String?
  area             String?
  type             String?
  tags             String[]                               @default([])
  latitude         Decimal?                               @db.Decimal(9, 6)
  longitude        Decimal?                               @db.Decimal(9, 6)
  geo              Unsupported("geography(Point, 4326)")?
  rating           Float?
  ratingCount      Int?
  priceLevel       Int?
  phone            String?
  website          String?
  openingHours     Json?
  status           String?
  editorialStatus  String                                 @default("AUTO")
  sourceConfidence Float?                                 @default(0)
  lastVerifiedAt   DateTime?
  publishedAt      DateTime?
  createdAt        DateTime                               @default(now())
  updatedAt        DateTime                               @updatedAt

  categories      PlaceCategory[]
  sources         PlaceSource[]
  photos          PlacePhoto[]
  collectionItems CollectionItem[]
  interactions    PlaceInteraction[]
  experiences     Experience[]

  @@index([latitude, longitude])
  @@index([area])
  @@index([type])
  @@index([editorialStatus, publishedAt])
  @@index([createdAt(sort: Desc)])
  @@map("places")
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  places PlaceCategory[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model PlaceCategory {
  placeId    String
  categoryId String
  source     String?
  confidence Float?  @default(1)

  place    Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([placeId, categoryId])
  @@index([categoryId])
  @@map("place_categories")
}

model PlaceSource {
  id          String    @id @default(cuid())
  placeId     String
  provider    String
  externalId  String
  sourceUrl   String?
  attribution String?
  license     String?
  raw         Json?
  fetchedAt   DateTime  @default(now())
  expiresAt   DateTime?

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([placeId])
  @@index([provider, expiresAt])
  @@map("place_sources")
}

model PlacePhoto {
  id             String    @id @default(cuid())
  placeId        String
  url            String
  sourceUrl      String?
  altText        String?
  kind           String    @default("PHOTO")
  provider       String?
  attribution    String?
  license        String?
  confidence     Float?
  verification   String    @default("VERIFIED")
  width          Int?
  height         Int?
  position       Int       @default(0)
  isPrimary      Boolean   @default(false)
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId, position])
  @@index([verification, lastVerifiedAt])
  @@map("place_photos")
}

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  image       String?
  status      String    @default("DRAFT")
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items CollectionItem[]

  @@index([status, startsAt, endsAt])
  @@map("collections")
}

model CollectionItem {
  collectionId String
  placeId      String
  position     Int     @default(0)
  note         String?

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  place      Place      @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([collectionId, placeId])
  @@index([collectionId, position])
  @@map("collection_items")
}

model Experience {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  image       String?
  venueId     String?
  startsAt    DateTime?
  endsAt      DateTime?
  bookingUrl  String?
  sourceUrl   String?
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  venue Place? @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([status, startsAt])
  @@index([venueId])
  @@map("experiences")
}

model PlaceInteraction {
  id          String   @id @default(cuid())
  placeId     String?
  kind        String
  anonymousId String?
  userId      String?
  metadata    Json?
  occurredAt  DateTime @default(now())

  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([placeId, kind, occurredAt(sort: Desc)])
  @@index([anonymousId, occurredAt(sort: Desc)])
  @@map("place_interactions")
}

model ExploreSearch {
  id              String   @id @default(cuid())
  query           String
  normalizedQuery String
  latitude        Decimal? @db.Decimal(9, 6)
  longitude       Decimal? @db.Decimal(9, 6)
  resultCount     Int      @default(0)
  anonymousId     String?
  createdAt       DateTime @default(now())

  @@index([normalizedQuery, createdAt(sort: Desc)])
  @@map("explore_searches")
}

model Pandal {
  id          String   @id @default(cuid())
  name        String
  location    String?
  description String?
  image       String?
  distance    String?
  rating      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@map("pandals")
}

model Region {
  id          String   @id @default(cuid())
  name        String
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@map("regions")
}

model Transport {
  id        String   @id @default(cuid())
  category  String
  name      String?
  location  String?
  distance  String?
  time      String?
  platform  String?
  routes    String[] @default([])
  from      String?
  to        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@map("transport")
}

model Community {
  id          String   @id @default(cuid())
  name        String
  description String?
  link        String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@map("communities")
}

model TinderProfile {
  id           String   @id @default(cuid())
  name         String
  age          String?
  bio          String?
  image        String?
  baseStars    Float    @default(3)
  averageStars Float?
  feedbacks    Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@map("tinder_profiles")
}

// Public stories on /community. Ephemeral: each expires 24 hours after it is
// posted. Only text and the original external URL are kept — never media.
// Editing sets editedAt and never moves createdAt or expiresAt: the day is
// counted from the first post.
model Story {
  id          String   @id @default(cuid())
  title       String
  story       String
  externalUrl String?
  authorId    String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  editedAt    DateTime?

  @@index([expiresAt, createdAt(sort: Desc)])
  @@map("stories")
}

// Puja moments: Instagram posts people submitted for review. Nothing in the app
// reads this table any more, but it holds submissions, so it stays described
// here: without a model, `db push` would drop it. @@ignore keeps it out of the
// Prisma client. Migration 20260923000000_puja_moments created it.
model PujaMoment {
  id           String   @id
  instagramUrl String   @unique
  category     String
  location     String
  caption      String?
  submitterId  String?
  status       String   @default("PENDING")
  featured     Boolean  @default(false)
  year         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([status, featured, createdAt(sort: Desc)])
  @@index([status, year, category, createdAt(sort: Desc)])
  @@map("puja_moments")
  @@ignore
}

// The Kolkata Puja datasets, loaded into the database by a scraper: pandals (with a
// generated geography point) and their photo gallery, immersion ghats, the panjika,
// points of interest, chronicles, a food trail, helplines, hotels and Metro lines.
// Brought in with `db pull` so `db push` keeps them; the model names are the table
// names, as introspection writes them. Re-pull whenever the scraper adds a table.

model kolkata_puja_pandals {
  slug                   String                    @id
  site_id                String?
  name                   String
  zone                   String?
  locality               String?
  address                String?
  lat                    Float?
  lng                    Float?
  geog                   Unsupported("geography")? @default(dbgenerated("\nCASE\n    WHEN ((lat IS NOT NULL) AND (lng IS NOT NULL)) THEN (st_setsrid(st_makepoint(lng, lat), 4326))::geography\n    ELSE NULL::geography\nEND"))
  coordinate_status      String?
  geocoded_by            String?
  is_location_verified   Boolean?
  nearest_metro          String?
  nearest_bus_stop       String?
  bus_routes             String[]
  categories             String[]
  theme_description      String?
  sculpted_by            String?
  year                   Int?
  established            Int?
  rating                 Decimal?                  @db.Decimal(3, 1)
  view_count             Int?
  crowd_level            String?
  image_url              String?
  gallery                String[]
  keywords               String[]
  meta_title             String?
  meta_description       String?
  is_hidden              Boolean?
  is_featured            Boolean?
  is_verified            Boolean?
  nearby_slugs           String[]
  source_url             String?
  raw                    Json?
  scraped_at             DateTime?                 @default(now()) @db.Timestamptz(6)
  pincode                String?
  red_road_carnival_rank Int?
  carnival_region        String?
  carnival_awards        String[]
  carnival_tableau       String?
  gallery_photo_count    Int?                      @default(0)
  kolkata_puja_gallery   kolkata_puja_gallery[]

  @@index([categories], map: "kpp_categories_idx", type: Gin)
  @@index([geog], map: "kpp_geog_idx", type: Gist)
  @@index([zone], map: "kpp_zone_idx")
}

model kolkata_puja_gallery {
  id                   String                @id
  pandal_slug          String?
  pandal_name          String?
  title                String?
  photographer         String?
  category             String?
  year                 Int?
  image_url            String?
  created_at           DateTime?             @db.Timestamptz(6)
  scraped_at           DateTime?             @default(now()) @db.Timestamptz(6)
  kolkata_puja_pandals kolkata_puja_pandals? @relation(fields: [pandal_slug], references: [slug], onUpdate: NoAction)

  @@index([pandal_slug], map: "kpg_slug_idx")
}

model kolkata_puja_immersion_ghats {
  name         String    @id
  name_bengali String?
  address      String?
  description  String?
  facilities   String[]
  eco_kmc      Boolean?
  scraped_at   DateTime? @default(now()) @db.Timestamptz(6)
}

model kolkata_puja_panzika {
  day_order      Int       @id
  day            String?
  start_date     DateTime? @db.Date
  date_label     String?
  tithi          String?
  tithi_end_time String?
  nakshatra      String?
  sunrise        String?
  sunset         String?
  brahma_muhurta String?
  key_moment     String?
  puja_highlight String?
  significance   String?
  rituals        Json?
  scraped_at     DateTime? @default(now()) @db.Timestamptz(6)
}

model kolkata_puja_pois {
  id         String                    @id
  name       String
  category   String?
  address    String?
  lat        Float?
  lng        Float?
  geog       Unsupported("geography")? @default(dbgenerated("(st_setsrid(st_makepoint(lng, lat), 4326))::geography"))
  phone      String?
  open_hours String?
  scraped_at DateTime?                 @default(now()) @db.Timestamptz(6)

  @@index([category], map: "kpoi_cat_idx")
  @@index([geog], map: "kpoi_geog_idx", type: Gist)
}

model kolkata_puja_chronicles {
  slug         String    @id
  title        String?
  excerpt      String?
  author       String?
  published_at DateTime? @db.Timestamptz(6)
  read_minutes Int?
  image        String?
  url          String?
  scraped_at   DateTime? @default(now()) @db.Timestamptz(6)
}

model kolkata_puja_food_trail {
  name       String    @id
  type       String?
  area       String?
  address    String?
  must_try   String?
  hours      String?
  scraped_at DateTime? @default(now()) @db.Timestamptz(6)
}

model kolkata_puja_helplines {
  name          String    @id
  number        String?
  location      String?
  always_active Boolean?
  scraped_at    DateTime? @default(now()) @db.Timestamptz(6)
}

model kolkata_puja_hotels {
  name          String    @id
  address       String?
  price_range   String?
  nearest_metro String?
  phone         String?
  area          String?
  scraped_at    DateTime? @default(now()) @db.Timestamptz(6)
}

model kolkata_puja_metro_lines {
  line          String    @id
  name_bengali  String?
  station_count Int?
  route_from    String?
  route_to      String?
  status        String?
  scraped_at    DateTime? @default(now()) @db.Timestamptz(6)
}

// Find your Ashtami date (/experience/swipe): 18+, opt-in, one Pujo season.
// A profile keeps a date of birth (never an age), a coarse area (never an
// address or coordinates) and photo keys in a private bucket that are never
// sent to anyone: photos go out as short-lived signed URLs. The rules live in
// lib/ashtami-date/rules.ts; the deck's query filters with the same ones.
model DateProfile {
  id           String    @id @default(cuid())
  // Supabase auth id. Never sent to another user.
  userId       String    @unique
  birthDate    DateTime  @db.Date
  firstName    String?
  gender       String? // woman | man | nonbinary
  showMe       String? // women | men | everyone
  night        String? // saptami | ashtami | navami | dashami
  zone         String? // a coarse area key, lib/ashtami-date/config.ts
  vibes        String[]  @default([])
  promptId     String?
  promptAnswer String?
  // shown only to a match, and only after the first message
  socialKind   String? // instagram | snapchat
  socialHandle String?
  archetype    String? // a Pujo Personality archetype, if they chose to show it
  consentedAt  DateTime?
  // every onboarding step done: on the deck
  active       Boolean   @default(false)
  // off the deck after reports from several people, until someone reviews it
  hiddenAt     DateTime?
  // the day's aajker special (pick of the day), once chosen
  pickDay      String?
  pickId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  photos     DatePhoto[]
  swipesMade DateSwipe[]   @relation("swiper")
  swipesGot  DateSwipe[]   @relation("target")
  matchesA   DateMatch[]   @relation("matchA")
  matchesB   DateMatch[]   @relation("matchB")
  messages   DateMessage[]

  // the deck: live profiles of the genders the viewer asked for, who asked for the viewer's
  @@index([active, gender, showMe, updatedAt(sort: Desc)])
  @@map("date_profiles")
}

model DatePhoto {
  id         String   @id @default(cuid())
  profileId  String
  // a random object name in the private bucket; nothing about the person
  storageKey String   @unique
  position   Int
  width      Int
  height     Int
  createdAt  DateTime @default(now())

  profile DateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // at most one photo per slot, so a profile can never hold more than the slots allow
  @@unique([profileId, position])
  @@map("date_photos")
}

model DateSwipe {
  id        String   @id @default(cuid())
  swiperId  String
  targetId  String
  liked     Boolean
  // the Kolkata day a shiuli (the super-like) was spent on: one per swiper per day
  shiuliDay String?
  createdAt DateTime @default(now())

  swiper DateProfile @relation("swiper", fields: [swiperId], references: [id], onDelete: Cascade)
  target DateProfile @relation("target", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([swiperId, targetId])
  @@unique([swiperId, shiuliDay])
  @@index([targetId, liked])
  @@map("date_swipes")
}

// A mutual "for me". aId is always the lower profile id, so a pair has one row.
model DateMatch {
  id             String    @id @default(cuid())
  aId            String
  bId            String
  createdAt      DateTime  @default(now())
  // no first message by then and the match is gone; null once someone writes
  expiresAt      DateTime?
  extensionsUsed Int       @default(0)
  firstMoveAt    DateTime?
  // the plan, fixed when they matched
  planNight      String
  planPandal     String
  planArea       String
  planNote       String
  planTime       String
  planZone       String
  aReadAt        DateTime?
  bReadAt        DateTime?

  a        DateProfile   @relation("matchA", fields: [aId], references: [id], onDelete: Cascade)
  b        DateProfile   @relation("matchB", fields: [bId], references: [id], onDelete: Cascade)
  messages DateMessage[]

  @@unique([aId, bId])
  @@index([bId])
  @@index([expiresAt])
  @@map("date_matches")
}

// Text only, and deleted 24 hours after it is sent.
model DateMessage {
  id        String   @id @default(cuid())
  matchId   String
  senderId  String
  body      String
  createdAt DateTime @default(now())
  expiresAt DateTime

  match  DateMatch   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender DateProfile @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@index([expiresAt])
  @@map("date_messages")
}

// By auth user id, not profile, so a block outlives either profile: someone
// who is blocked can't delete and come back to find the person again.
model DateBlock {
  id            String   @id @default(cuid())
  blockerUserId String
  blockedUserId String
  createdAt     DateTime @default(now())

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId])
  @@map("date_blocks")
}

// Kept for a person to review. evidence is the reported person's messages in
// that chat, copied at report time, because the chat itself is deleted.
model DateReport {
  id             String   @id @default(cuid())
  reporterUserId String
  reportedUserId String
  reason         String
  note           String?
  evidence       Json?
  status         String   @default("OPEN") // OPEN | REVIEWED
  createdAt      DateTime @default(now())

  @@index([reportedUserId, status])
  @@index([reporterUserId, createdAt])
  @@index([createdAt])
  @@map("date_reports")
}

/// One row per live feed on /home (lib/live): what Anakin last returned,
/// already reduced to what the page shows. Refreshed after a page view when
/// stale, and by /api/cron/live; the page only ever reads it.
model LiveFeed {
  key         String    @id
  payload     Json?
  fetchedAt   DateTime?
  /// the last refresh attempt, successful or not; also the refresh lease
  attemptedAt DateTime?
  error       String?

  @@map("live_feeds")
}
